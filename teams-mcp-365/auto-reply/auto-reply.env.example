# Chép thành ~/.config/teams-auto-reply/env rồi điền giá trị thật. File thật không commit.
# Thư mục chạy `claude -p` (nơi có CLAUDE.md quy định xưng hô, chính sách gửi).
WORKDIR=/path/to/project
# Nhóm Teams được phép tự trả lời (lấy chat ID bằng list_teams_chats).
CHAT_ID='19:<chat-id>@thread.v2'
CHAT_NAME='<Tên nhóm>'
# Tên hiển thị của bạn trên Teams, để bỏ qua tin bạn đã tự trả lời.
OWNER_NAME='<Họ tên>'
MODEL=claude-sonnet-5-5
INTERVAL=300
USAGE_LIMIT=90
# Skill văn phong; bỏ trống hoặc trỏ tới file không tồn tại để tắt.
HUMAN_VOICE=$HOME/.claude/skills/human-voice/SKILL.md
